{
  "name": "@pitchfork-ui/react",
  "version": "0.16.0",
  "description": "DEPRECATED \u2014 use @pitchfork-ui/elements instead. The former React component library for Pitchfork UI; still installable and patched for security until 30 April 2027.",
  "license": "MIT",
  "author": "Leland Rangel",
  "homepage": "https://lelandrangel.com/pitchfork-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lelandcrangel/pitchfork-ui.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/lelandcrangel/pitchfork-ui/issues"
  },
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "ui",
    "components",
    "accessible",
    "a11y",
    "dark-mode",
    "design-tokens",
    "typescript"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "dist/**/*.css",
    "src/**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && node ../../scripts/fix-dts-extensions.mjs",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "prism-react-renderer": "^2.0.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "dependencies": {
    "@pitchfork-ui/core": "^0.2.0",
    "@pitchfork-ui/tokens": "^0.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-lib-inject-css": "^2.2.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./metadata": "./dist/metadata.json"
  }
}
