{
  "name": "@pitchfork-ui/react",
  "version": "0.8.0",
  "description": "Accessible, themeable React component library for lelandrangel.com — 65+ components backed by a Style Dictionary token system, with dark mode and bundled CSS.",
  "license": "MIT",
  "author": "Leland Rangel",
  "homepage": "https://lelandrangel.com/pitchfork-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lelandcrangel/pitchfork-ui.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/lelandcrangel/pitchfork-ui/issues"
  },
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "ui",
    "components",
    "accessible",
    "a11y",
    "dark-mode",
    "design-tokens",
    "typescript"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/src/index.d.ts",
  "sideEffects": [
    "dist/**/*.css",
    "src/**/*.css"
  ],
  "files": [
    "dist",
    "theme.starter.css",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "prism-react-renderer": "^2.0.0",
    "react": ">=18.2.0 || >=19.0.0",
    "react-dom": ">=18.2.0 || >=19.0.0"
  },
  "devDependencies": {
    "@pitchfork-ui/tokens": "^0.1.0",
    "@vitejs/plugin-react": "latest",
    "vite-plugin-dts": "latest",
    "vite-plugin-lib-inject-css": "^2.2.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.starter.css": "./theme.starter.css"
  }
}
