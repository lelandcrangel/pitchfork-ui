{"version":3,"names":["pfButtonCss","PfButton","variant","size","fullWidth","loading","disabled","type","label","renderSpinner","h","class","part","viewBox","fill","width","height","focusable","cx","cy","r","stroke","render","isDisabled","this","Host","key"],"sources":["src/components/pf-button/pf-button.css?tag=pf-button&encapsulation=shadow","src/components/pf-button/pf-button.tsx"],"sourcesContent":["/*\n * `@keyframes` do not cross a shadow boundary. In the React library pf-spin is\n * declared once in LoadingIndicators.css and every component picks it up from\n * the global sheet; here each shadow root needs its own copy.\n */\n@keyframes pf-spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n:host {\n  display: inline-flex;\n}\n\n:host([full-width]) {\n  display: flex;\n  width: 100%;\n}\n\n:host([hidden]) {\n  display: none;\n}\n\nbutton {\n  align-items: center;\n  background: none;\n  border: 1px solid transparent;\n  border-radius: var(--radius-md);\n  color: inherit;\n  cursor: pointer;\n  display: inline-flex;\n  flex: 1;\n  font-family: inherit;\n  font-size: inherit;\n  font-weight: var(--font-weight-semibold);\n  gap: var(--space-2);\n  justify-content: center;\n  line-height: 1;\n  min-height: 40px;\n  text-decoration: none;\n  transition:\n    background-color var(--pf-transition-fast),\n    border-color var(--pf-transition-fast),\n    color var(--pf-transition-fast),\n    box-shadow var(--pf-transition-fast);\n}\n\nbutton:focus-visible {\n  box-shadow: var(--pf-button-focus-ring, var(--pf-focus-ring));\n  outline: none;\n}\n\nbutton:disabled {\n  cursor: not-allowed;\n  opacity: 0.55;\n}\n\n:host([size='sm']) button {\n  font-size: var(--font-size-sm);\n  min-height: 36px;\n  padding: 0 var(--space-3);\n}\n\n:host([size='md']) button {\n  font-size: var(--font-size-md);\n  min-height: 40px;\n  padding: 0 var(--space-4);\n}\n\n:host([size='lg']) button {\n  font-size: var(--font-size-lg);\n  min-height: 48px;\n  padding: 0 var(--space-5);\n}\n\n:host([variant='primary']) button {\n  background: var(--pf-button-primary-bg);\n  color: var(--pf-button-primary-text);\n}\n\n:host([variant='primary']) button:hover:not(:disabled) {\n  background: var(--pf-button-primary-bg-hover);\n}\n\n:host([variant='secondary']) button {\n  background: var(--pf-button-secondary-bg);\n  border-color: var(--pf-button-secondary-border);\n  color: var(--pf-button-secondary-text);\n}\n\n:host([variant='secondary']) button:hover:not(:disabled) {\n  background: var(--pf-button-secondary-bg-hover);\n  border-color: var(--pf-button-secondary-border-hover);\n}\n\n:host([variant='ghost']) button {\n  background: transparent;\n  color: var(--pf-button-ghost-text);\n}\n\n:host([variant='ghost']) button:hover:not(:disabled) {\n  background: var(--pf-button-ghost-bg-hover);\n}\n\n:host([variant='destructive']) button {\n  background: var(--pf-button-destructive-bg);\n  color: var(--pf-button-destructive-text);\n}\n\n:host([variant='destructive']) button:hover:not(:disabled) {\n  background: var(--pf-button-destructive-bg-hover);\n}\n\n:host([loading]) button:disabled {\n  cursor: wait;\n  opacity: 1;\n}\n\n.spinner {\n  animation: pf-spin 0.65s linear infinite;\n  flex-shrink: 0;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  button {\n    transition: none;\n  }\n\n  .spinner {\n    animation-duration: 0.01ms;\n    animation-iteration-count: 1;\n  }\n}\n\n@media (--md) {\n  button {\n    min-height: 44px;\n  }\n}\n","import { Component, Element, h, Host, Prop } from '@stencil/core';\n\nexport type PfButtonVariant = 'primary' | 'secondary' | 'ghost' | 'destructive';\nexport type PfButtonSize = 'sm' | 'md' | 'lg';\nexport type PfButtonType = 'button' | 'submit' | 'reset';\n\n/**\n * @slot - the button's label.\n * @part button - the native button element.\n * @part spinner - the loading spinner.\n */\n@Component({\n  tag: 'pf-button',\n  styleUrl: 'pf-button.css',\n  // delegatesFocus so that focusing <pf-button> reaches the real button, and\n  // :focus-visible lands on the element that is actually styled for it.\n  shadow: { delegatesFocus: true },\n})\nexport class PfButton {\n  @Element() host!: HTMLElement;\n\n  /** Visual style. Reflected so the stylesheet can select on it. */\n  @Prop({ reflect: true }) variant: PfButtonVariant = 'primary';\n\n  /** Control size. Reflected so the stylesheet can select on it. */\n  @Prop({ reflect: true }) size: PfButtonSize = 'md';\n\n  /** Stretch to the width of the container. */\n  @Prop({ reflect: true }) fullWidth = false;\n\n  /** Show a spinner and block interaction. */\n  @Prop({ reflect: true }) loading = false;\n\n  /** Disable the button. */\n  @Prop({ reflect: true }) disabled = false;\n\n  /**\n   * Mirrors the native attribute. `submit` and `reset` do not yet act on a form\n   * outside this element's shadow root -- that needs ElementInternals, which\n   * arrives with the form controls in Wave 3.\n   */\n  @Prop() type: PfButtonType = 'button';\n\n  /** Accessible name, for when the slot holds only an icon. */\n  @Prop() label?: string;\n\n  private renderSpinner() {\n    return (\n      <svg\n        class=\"spinner\"\n        part=\"spinner\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        width=\"1em\"\n        height=\"1em\"\n        aria-hidden=\"true\"\n        focusable=\"false\"\n      >\n        <circle\n          cx=\"12\"\n          cy=\"12\"\n          r=\"10\"\n          stroke=\"currentColor\"\n          stroke-width=\"3\"\n          stroke-linecap=\"round\"\n          stroke-dasharray=\"32\"\n          stroke-dashoffset=\"8\"\n        />\n      </svg>\n    );\n  }\n\n  render() {\n    const isDisabled = this.disabled || this.loading;\n\n    return (\n      <Host>\n        <button\n          part=\"button\"\n          type={this.type}\n          disabled={isDisabled}\n          aria-busy={this.loading ? 'true' : null}\n          aria-label={this.label}\n        >\n          {this.loading && this.renderSpinner()}\n          <slot />\n        </button>\n      </Host>\n    );\n  }\n}\n"],"mappings":"yDAAA,MAAMA,EAAc,IAAM,uxE,MCkBbC,EAAQ,M,mDAIMC,QAA2B,UAG3BC,KAAqB,KAGrBC,UAAY,MAGZC,QAAU,MAGVC,SAAW,MAO5BC,KAAqB,SAGrBC,MAEA,aAAAC,GACN,OACEC,EAAA,OACEC,MAAM,UACNC,KAAK,UACLC,QAAQ,YACRC,KAAK,OACLC,MAAM,MACNC,OAAO,MAAK,cACA,OACZC,UAAU,SAEVP,EAAA,UACEQ,GAAG,KACHC,GAAG,KACHC,EAAE,KACFC,OAAO,eAAc,eACR,IAAG,iBACD,QAAO,mBACL,KAAI,oBACH,M,CAM1B,MAAAC,GACE,MAAMC,EAAaC,KAAKlB,UAAYkB,KAAKnB,QAEzC,OACEK,EAACe,EAAI,CAAAC,IAAA,4CACHhB,EAAA,UAAAgB,IAAA,2CACEd,KAAK,SACLL,KAAMiB,KAAKjB,KACXD,SAAUiB,EAAU,YACTC,KAAKnB,QAAU,OAAS,KAAI,aAC3BmB,KAAKhB,OAEhBgB,KAAKnB,SAAWmB,KAAKf,gBACtBC,EAAA,QAAAgB,IAAA,8C","ignoreList":[]}