          "border": {
            "$value": "{color.danger.200}",
            "$type": "color",
            "$description": "Sized against the danger background, which is the tighter constraint: an earlier note justified danger-600 by its 3.70:1 on gray-900 and never checked it against danger-900, where the same colour is 2.04:1. danger-500 gives 2.62:1, so danger-400 (3.53:1) is the darkest step that passes. It matches status.danger.bright; they never appear adjacent.",
            "$extensions": {
              "pitchfork.dark": "{color.danger.400}"
            }
          },
          "foreground": {
            "$value": "{color.danger.700}",
            "$type": "color",
