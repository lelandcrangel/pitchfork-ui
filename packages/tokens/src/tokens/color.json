      },
      "border": {
        "muted": {
          "$value": "{color.gray.100}",
          "$type": "color",
          "$extensions": {
            "pitchfork.dark": "{color.gray.800}"
          }
        },
        "default": {
          "$value": "{color.gray.200}",
          "$type": "color",
          "$description": "Drives --pf-control-border and --pf-button-secondary-border, which are UI components under WCAG 1.4.11 and need 3:1. In dark mode gray-700 gave 1.72:1 on the default background and 1.41:1 on raised, and gray-600 only reaches 2.36:1, so gray-500 is the darkest step that passes.",
          "$extensions": {
            "pitchfork.dark": "{color.gray.500}"
          }
        },
        "strong": {
          "$value": "{color.gray.300}",
          "$type": "color",
          "$description": "Moves with border.default in dark mode, because it is the hover state of those same borders and would otherwise be identical to their resting state.",
          "$extensions": {
            "pitchfork.dark": "{color.gray.400}"
          }
        },
        "focus": {
          "$value": "{color.brand.500}",
          "$type": "color",
          "$extensions": {
            "pitchfork.dark": "{color.brand.400}"
          }
        },
        "disabled": {
          "$value": "{color.gray.200}",
          "$type": "color",
          "$description": "Mirrors border.default in both modes, which is the relationship light mode already had (both gray-200). It had no dark value until the modes were unified: --pf-control-border-disabled pointed straight at the gray-200 primitive, so a disabled border stayed at 14.48:1 on the dark background while the enabled one moved to 3.75:1 — the disabled control read as the more prominent of the two. WCAG exempts disabled controls, so no contrast check caught it.",
          "$extensions": {
            "pitchfork.dark": "{color.gray.500}"
          }
        }
      },
      "action": {
        "primary": {
          "$value": "{color.brand.700}",
          "$type": "color",
          "$description": "brand-600 (#2563eb) on white is ~5:1, which passes WCAG AA for normal text.",
          "$extensions": {
            "pitchfork.dark": "{color.brand.600}"
          }
        },
        "primaryHover": {
          "$value": "{color.brand.800}",
          "$type": "color",
          "$extensions": {
            "pitchfork.dark": "{color.brand.700}"
          }
        },
        "primaryActive": {
          "$value": "{color.brand.900}",
