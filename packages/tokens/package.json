{
  "name": "@pitchfork-ui/tokens",
  "version": "0.5.0",
  "description": "Design tokens and the theme layer for Pitchfork UI — colour, spacing, radii, typography, shadow and motion built with Style Dictionary, plus the --pf-* alias layer and dark mode every rendering layer shares.",
  "license": "MIT",
  "author": "Leland Rangel",
  "homepage": "https://lelandrangel.com/pitchfork-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lelandcrangel/pitchfork-ui.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/lelandcrangel/pitchfork-ui/issues"
  },
  "keywords": [
    "design-tokens",
    "style-dictionary",
    "css-variables",
    "design-system",
    "pitchfork-ui",
    "theming",
    "dark-mode"
  ],
  "type": "module",
  "sideEffects": [
    "dist/**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./css": "./dist/css/variables.css",
    "./variables.css": "./dist/css/variables.css",
    "./tokens": "./dist/json/tokens.json",
    "./theme.css": "./dist/css/theme.css"
  },
  "scripts": {
    "build": "style-dictionary build --config style-dictionary.config.mjs && cp src/theme.css dist/css/theme.css",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "style-dictionary": "^5.6.0"
  }
}
