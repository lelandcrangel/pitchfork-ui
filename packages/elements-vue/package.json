{
  "name": "@pitchfork-ui/elements-vue",
  "version": "0.2.0",
  "description": "Vue bindings for @pitchfork-ui/elements — typed Vue components generated from the Pitchfork UI custom elements.",
  "license": "MIT",
  "author": "Leland Rangel",
  "homepage": "https://lelandrangel.com/pitchfork-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lelandcrangel/pitchfork-ui.git",
    "directory": "packages/elements-vue"
  },
  "bugs": {
    "url": "https://github.com/lelandcrangel/pitchfork-ui/issues"
  },
  "keywords": [
    "vue",
    "web-components",
    "custom-elements",
    "design-system",
    "pitchfork-ui",
    "stencil"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && node ../../scripts/fix-dts-extensions.mjs dist"
  },
  "dependencies": {
    "@pitchfork-ui/elements": "^0.1.0",
    "@stencil/vue-output-target": "^0.14.3"
  },
  "peerDependencies": {
    "vue": ">=3.4.38"
  },
  "devDependencies": {
    "vite-plugin-dts": "^5.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
