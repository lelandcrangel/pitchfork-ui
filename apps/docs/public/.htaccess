RewriteEngine On
RewriteBase /pitchfork-ui/

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.html [L]

# Cache policy.
#
# Storybook fingerprints everything it emits into assets/, but index.html,
# iframe.html, index.json and the generated llms files keep the same names
# across every build. A browser that cached those keeps rendering the previous
# deploy from its own disk, which is indistinguishable from a deploy that never
# happened -- you reload, nothing changes, and the logs say success.
#
# So: revalidate the entries, cache the fingerprinted assets forever.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # name-<hash>.js / .css, which is every file Vite emits into assets/.
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
