{
  "name": "@pitchfork-ui/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-changelog": "node ./sync-changelog.cjs",
    "storybook": "npm run sync-changelog && storybook dev -p 6006",
    "build": "npm run sync-changelog && storybook build",
    "build:hostinger": "npm run sync-changelog && STORYBOOK_BASE_PATH=/pitchfork-ui/ storybook build",
    "test:a11y-dark": "vitest run --config vitest.storybook.dark.config.ts"
  },
  "dependencies": {
    "@pitchfork-ui/react": "*",
    "@pitchfork-ui/tokens": "*",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "*"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-vitest": "^10.4.2",
    "mockdate": "^3.0.5",
    "msw": "^2.14.6",
    "msw-storybook-addon": "^2.0.7"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
