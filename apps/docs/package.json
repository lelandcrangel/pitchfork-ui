{
  "name": "@pitchfork-ui/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-changelog": "node ./sync-changelog.cjs",
    "storybook": "npm run sync-changelog && storybook dev -p 6006",
    "build": "npm run sync-changelog && storybook build",
    "build:hostinger": "npm run sync-changelog && STORYBOOK_BASE_PATH=/pitchfork-ui/ storybook build",
    "test:a11y-dark": "vitest run --config vitest.storybook.dark.config.ts"
  },
  "dependencies": {
    "@pitchfork-ui/core": "*",
    "@pitchfork-ui/elements": "*",
    "@pitchfork-ui/tokens": "*",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.4.0",
    "@storybook/addon-vitest": "^10.6.1",
    "mockdate": "^3.0.5",
    "remark-gfm": "^4.0.1"
  }
}
