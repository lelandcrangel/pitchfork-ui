{
  "name": "@pitchfork-ui/consumer-angular",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Builds a real Angular application against the published @pitchfork-ui/elements-angular, including a reactive form bound through the generated ControlValueAccessor.",
