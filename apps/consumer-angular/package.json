    "@angular/common": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@pitchfork-ui/core": "*",
    "@pitchfork-ui/elements": "*",
    "@pitchfork-ui/elements-angular": "*",
    "rxjs": "^7.8.2",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.5",
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler": "^21.2.25",
    "typescript": "*",
    "vite": "*"
  }
}
