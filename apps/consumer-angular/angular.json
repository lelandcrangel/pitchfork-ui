{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "consumer-angular": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist",
              "browser": ""
            },
            "index": "index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": [
              "../../node_modules/@pitchfork-ui/elements/dist/pitchfork/pitchfork.css",
              "src/main.css"
            ],
            "polyfills": ["zone.js"]
          }
        }
      }
    }
  }
}
