node_modules
.DS_Store
dist
storybook-static
coverage
.env
*.tsbuildinfo

# Generated from packages/react/dist/metadata.json by scripts/build-llms-txt.mjs
apps/docs/public/llms.txt
apps/docs/public/llms-full.txt

# Generated from packages/react/CHANGELOG.md by apps/docs/sync-changelog.cjs,
# which every docs build and `npm run storybook` runs first.
apps/docs/src/CHANGELOG.mdx

# Copied from the built artifacts by scripts/build-mcp-data.mjs
packages/mcp/data/

# Stencil emits the loader beside dist
packages/elements/loader

# Stencil's build cache
packages/elements/.stencil

# Generated by the Stencil React output target on every elements build
packages/elements-react/src/components/

# Vitest browser screenshots on failure
**/__screenshots__/
# Vitest browser mode failure artefacts
**/.vitest-attachments/

# Generated by the Stencil Angular output target on every elements build
packages/elements-angular/src/lib/

# Generated from the tokens and theme layers on every elements build
packages/elements/src/global/

# Angular CLI's compiler cache
**/.angular/
