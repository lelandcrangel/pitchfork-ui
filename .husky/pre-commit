#!/bin/sh
ERRORS=$(mktemp)
echo "Running pre-commit lint checks..."
if ! npx lint-staged > "$ERRORS" 2>&1; then
  cat "$ERRORS"
  rm -f "$ERRORS"
  echo ""
  echo "─────────────────────────────────────────────────────"
  echo "Pre-commit checks failed. Fix the errors above."
  echo "Tip: run 'npm run lint' to see all lint errors."
  echo "To skip in an emergency: git commit --no-verify"
  echo "─────────────────────────────────────────────────────"
  exit 1
fi
rm -f "$ERRORS"
