{
  "name": "pitchfork-ui-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run storybook -w @pitchfork-ui/docs",
    "storybook": "npm run storybook -w @pitchfork-ui/docs",
    "build": "npm run build -w @pitchfork-ui/tokens && npm run build -w @pitchfork-ui/react && npm run build -w @pitchfork-ui/docs",
    "build:tokens": "npm run build -w @pitchfork-ui/tokens",
    "build:react": "npm run build -w @pitchfork-ui/react",
    "test": "npm run test -w @pitchfork-ui/react",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier . --write"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "playwright": "^1.60.0",
    "prettier": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vite-plugin-dts": "latest",
    "vitest": "latest"
  },
  "dependencies": {
    "prism-react-renderer": "^2.4.1"
  }
}
