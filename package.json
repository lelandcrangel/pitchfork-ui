{
  "name": "pitchfork-ui-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run storybook -w @pitchfork-ui/docs",
    "dev:theme-builder": "npm run dev -w @pitchfork-ui/theme-builder",
    "dev:demo": "npm run dev -w @pitchfork-ui/demo",
    "storybook": "npm run storybook -w @pitchfork-ui/docs",
    "build": "npm run build -w @pitchfork-ui/tokens && npm run build -w @pitchfork-ui/react && npm run build -w @pitchfork-ui/docs",
    "build:hostinger": "npm run build -w @pitchfork-ui/tokens && npm run build -w @pitchfork-ui/react && npm run build:hostinger -w @pitchfork-ui/docs && npm run build:hostinger -w @pitchfork-ui/theme-builder",
    "build:demo": "npm run build -w @pitchfork-ui/tokens && npm run build -w @pitchfork-ui/react && npm run build -w @pitchfork-ui/demo",
    "build:tokens": "npm run build -w @pitchfork-ui/tokens",
    "build:react": "npm run build -w @pitchfork-ui/react",
    "test": "npm run test -w @pitchfork-ui/react",
    "test:coverage": "npm run test:coverage -w @pitchfork-ui/react",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "latest",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "husky": "^9.1.7",
    "jsdom": "latest",
    "lint-staged": "^17.0.7",
    "playwright": "^1.60.0",
    "postcss-custom-media": "latest",
    "prettier": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vite-plugin-dts": "latest",
    "vitest": "latest"
  },
  "dependencies": {
    "prism-react-renderer": "^2.4.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,mdx}": "prettier --write"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "optionalDependencies": {
    "@oxc-parser/binding-linux-x64-gnu": "0.142.0",
    "@oxc-resolver/binding-linux-x64-gnu": "11.24.2"
  }
}
